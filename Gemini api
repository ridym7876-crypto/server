const express = require('express');
const fetch = require('node-fetch'); 
const cors = require('cors');
const app = express();

app.use(cors());
app.use(express.json());
app.use(express.static('public'));

const GEMINI_API_KEY = "YOUR_GEMINI_KEY"; //curl "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent" \
  -H 'Content-Type: application/json' \
  -H 'X-goog-api-key: GEMINI_API_KEY' \
  -X POST \
  -d '{
    "contents": [
      {
        "parts": [
          {
            "text": "Explain how AI works in a few words"
          }
        ]
      }
    ]
  }'

let usageCount = {};

app.post('/api/chat', async (req,res)=>{
  const { message, userId } = req.body;
  if(!usageCount[userId]) usageCount[userId]=0;
  if(usageCount[userId]>=50) return res.json({ reply:"Free limit reached!" });

  try{
    const response = await fetch(
      "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
      {
        method:"POST",
        headers:{
          "Content-Type":"application/json",
          "X-goog-api-key": GEMINI_API_KEY
        },
        body: JSON.stringify({ contents:[{ parts:[{ text: message }] }] })
      }
    );
    const data = await response.json();
    const botReply = data?.candidates?.[0]?.content?.[0]?.text || "No reply from Gemini";
    usageCount[userId] += 1;
    res.json({ reply: botReply, remaining: 50-usageCount[userId] });
  }catch(err){
    console.error(err);
    res.status(500).json({ reply:"Error connecting to Gemini API" });
  }
});

app.listen(5000, ()=>console.log("Server running on http://localhost:5000"));
